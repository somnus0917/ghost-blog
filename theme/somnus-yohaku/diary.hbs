{{!< default}}
{{#contentFor "title_prefix"}}日记 · {{/contentFor}}
{{#contentFor "head_extra"}}
    {{> "route-description" description="日常生活、阶段记录与时间留下的片段。"}}
{{/contentFor}}

<section class="archive-shell">
    <header class="archive-header">
        <p>FIELD DIARY</p>
        <h1>日记</h1>
    </header>

    <div class="archive-list">
        {{#foreach posts}}
            {{> "post-row"}}
        {{/foreach}}
    </div>

    {{pagination}}
</section>
