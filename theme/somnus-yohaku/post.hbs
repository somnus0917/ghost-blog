{{!< default}}

{{#post}}
<article class="article-shell {{post_class}}">
    <header class="article-header">
        <p class="article-eyebrow">{{#foreach tags visibility="public" limit="1"}}{{name}}{{else}}POST{{/foreach}}</p>
        <h1>{{title}}</h1>
        <div class="article-meta">
            <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="YYYY年M月D日"}}</time>
            <span>·</span>
            <span>{{reading_time minute="1 分钟阅读" minutes="% 分钟阅读"}}</span>
            <span class="article-engagement" data-post-engagement data-post-uuid="{{uuid}}" hidden>
                <span data-engagement-views-wrap hidden><span data-engagement-views>0</span> 次阅读</span>
                <span data-engagement-likes-wrap hidden><span data-engagement-likes>0</span> 次喜欢</span>
            </span>
            {{#if featured}}<span>·</span><span>精选</span>{{/if}}
        </div>
        <p class="article-presence" data-engagement-presence aria-live="polite" hidden></p>
    </header>

    {{#if feature_image}}
        <figure class="article-cover">
            <img
                src="{{img_url feature_image size="l"}}"
                srcset="{{img_url feature_image size="s"}} 480w, {{img_url feature_image size="m"}} 960w, {{img_url feature_image size="l"}} 1600w"
                sizes="(max-width: 620px) calc(100vw - 40px), (max-width: 1180px) calc(100vw - 48px), 1080px"
                alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                width="1600"
                height="1000"
                decoding="async"
                fetchpriority="high"
            >
            {{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}
        </figure>
    {{/if}}

    <div class="article-layout">
        <aside class="article-toc" data-article-toc aria-label="文章目录">
            <p>ON THIS PAGE</p>
            <nav></nav>
        </aside>
        <div class="article-content gh-content">
            {{content}}
        </div>
        <aside class="article-actions" aria-label="文章操作">
            <button type="button" data-like-post title="喜欢这篇文章" aria-label="喜欢这篇文章" aria-pressed="false" hidden>♡</button>
            <button type="button" data-copy-url title="复制文章链接" aria-label="复制文章链接">↗</button>
            <button type="button" data-ghost-search title="站内搜索" aria-label="站内搜索">⌕</button>
            <a href="#comments" title="查看评论" aria-label="查看评论">⌄</a>
        </aside>
    </div>

    <footer class="article-footer">
        <p>{{title}} · {{primary_author.name}}</p>
        <p><a href="{{url absolute="true"}}">{{url absolute="true"}}</a></p>
        <p>本文内容由 Somnus 创作，转载请保留原文链接。</p>
    </footer>
</article>

<section class="comments-shell" id="comments" aria-labelledby="comments-title">
    <header class="comments-header">
        <h2 id="comments-title">评论</h2>
        <p class="comments-note">注册或登录后即可评论。</p>
    </header>
    <div class="comments-loader" data-comments-placeholder>
        <span>评论将在接近此处时加载。</span>
        <button type="button" data-load-comments>立即加载</button>
    </div>
    <div data-comments-mount>
        <template data-comments-template>
            {{comments title="" count=false mode="auto"}}
        </template>
    </div>
    <noscript><p class="comments-noscript">请启用 JavaScript 查看评论。</p></noscript>
</section>
{{/post}}
