GHOST_URL=http://127.0.0.1:2369
# Production only: keep mutable data outside the Git checkout. The defaults in
# docker-compose.yml keep local development data in ./content and ./mysql.
# GHOST_CONTENT_DIR=/home/ubuntu/ghost-data/content
# MYSQL_DATA_DIR=/home/ubuntu/ghost-data/mysql
# BACKUP_DIR=/home/ubuntu/ghost-data/backups
MYSQL_DATABASE=ghost
MYSQL_USER=ghost
MYSQL_PASSWORD=replace-with-a-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-random-password
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=replace-with-resend-api-key
MAIL_FROM='Somnus <noreply@mail.somnus.wiki>'

# Generate two different random values for the Caddy trust boundaries.
# Configure the same values as the corresponding Worker secrets.
WORKER_PROXY_SECRET=replace-with-at-least-32-random-characters
MEMBERS_PROXY_SECRET=replace-with-a-different-32-character-random-value

# Ghost 6 native analytics (enable only after completing Tinybird login/deploy)
# COMPOSE_PROFILES=analytics
# TINYBIRD_API_URL=https://api.tinybird.co
# TINYBIRD_TRACKER_TOKEN=replace-with-tinybird-tracker-token
# TINYBIRD_ADMIN_TOKEN=replace-with-tinybird-admin-token
# TINYBIRD_WORKSPACE_ID=replace-with-tinybird-workspace-id

# Optional encrypted offsite backups with restic.
# RESTIC_REPOSITORY=s3:s3.amazonaws.com/your-private-backup-bucket/ghost
# RESTIC_PASSWORD_FILE=/home/ubuntu/.config/restic/ghost-password
# AWS_ACCESS_KEY_ID=replace-with-backup-only-access-key
# AWS_SECRET_ACCESS_KEY=replace-with-backup-only-secret
